{
  "name": "legicite",
  "version": "0.1.0",
  "private": true,
  "description": "Extension Word de citation et de consultation des textes legaux francais (API Legifrance / PISTE).",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "icons": "node tools/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && node tools/deploy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/office-js": "^1.0.608",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "fontkit": "^2.0.4",
    "html-webpack-plugin": "^5.6.8",
    "office-addin-debugging": "^6.1.2",
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "sharp": "^0.35.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
